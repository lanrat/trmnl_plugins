{% if error or gas.error %}
<div class="layout layout--col gap--space-between">
  <div class="flex flex--col flex--center-x flex--center-y grow">
    <span class="title">Gas Prices</span>
    <span class="description mt--4">{{ error | default: gas.error }}</span>
  </div>
</div>
<div class="title_bar">
  <span class="title">Gas Prices</span>
</div>

{% elsif gas.stations.size > 0 %}

<style>
  .gas-view {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .trend-row {
    display: flex;
    justify-content: space-around;
    align-items: flex-start;
    width: 100%;
    overflow: hidden;
    flex-shrink: 0;
    gap: 12px;
    padding-bottom: 6px;
  }
  .trend-cell {
    flex: 1 1 0;
    min-width: 0;
    text-align: center;
    overflow: hidden;
  }
  .trend-cell .value {
    display: block;
  }
  .trend-cell .label {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .stations {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    overflow: hidden;
  }
  .station-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 4px 0;
    border-bottom: 1px dotted #000;
    width: 100%;
    box-sizing: border-box;
  }
  .station-row:last-child {
    border-bottom: none;
  }
  .station-row.cheapest {
    border: 2px solid #000;
    padding: 4px 6px;
  }
  .cheapest-badge {
    display: inline-block;
    font-size: 0.7em;
    font-weight: bold;
    border: 1px solid #000;
    padding: 0 4px;
    margin-right: 4px;
    vertical-align: 2px;
    text-transform: uppercase;
  }
  .station-info {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
  }
  .station-info .description {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }
  .station-address {
    font-size: 0.85em;
  }
  .station-price {
    flex-shrink: 0;
    margin-left: 12px;
  }
  .trend-up::after { content: " \25B2"; }
  .trend-down::after { content: " \25BC"; }
  .trend-flat::after { content: " \25C6"; }
  .view--half_vertical .trend-row,
  .view--quadrant .trend-row {
    display: none;
  }
  .view--quadrant .station-address {
    display: none;
  }
  /* cap rows per smaller layout to prevent overflow */
  .view--half_vertical .station-row:nth-child(n+6) { display: none; }
  .view--half_horizontal .station-row:nth-child(n+5) { display: none; }
  .view--quadrant .station-row:nth-child(n+4) { display: none; }
</style>

<div class="gas-view">
  {% if gas.trends.size > 0 %}
  <div class="trend-row">
    {% for trend in gas.trends %}
    <div class="trend-cell">
      <span class="value value--xsmall value--tnums" data-value-type="number">
        ${{ trend.average_display }}
      </span>
      <span class="label">
        {{ trend.area }}
        {% if trend.direction == 1 %}<span class="trend-up"></span>
        {% elsif trend.direction == -1 %}<span class="trend-down"></span>
        {% else %}<span class="trend-flat"></span>
        {% endif %}
      </span>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="stations">
    {% for station in gas.stations %}
    <div class="station-row{% if forloop.first %} cheapest{% endif %}">
      <div class="station-info">
        <span class="description">
          {% if forloop.first %}<span class="cheapest-badge">Cheapest</span>{% endif %}
          <strong>{{ station.name }}</strong>
        </span>
        <span class="description station-address">
          {{ station.address }}
        </span>
      </div>
      <div class="station-price">
        <span class="value value--xsmall value--tnums" data-value-type="number">${{ station.display }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">Gas Prices — {{ gas.fuel_label }}</span>
  <span class="instance">{{ gas.search }}</span>
</div>

{% else %}

<div class="layout layout--col gap--space-between">
  <div class="flex flex--col flex--center-x flex--center-y grow">
    <span class="title">Gas Prices</span>
    <span class="description mt--4">No stations found for "{{ gas.search }}"</span>
  </div>
</div>
<div class="title_bar">
  <span class="title">Gas Prices</span>
</div>

{% endif %}
