<style>
  .view {
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
  }
  .image-container {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0px;
    overflow: hidden;
    min-height: 0;
  }
  .image-container img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    border-radius: 5px;
  }
</style>
<div class="view bg-white">
  <div class="image-container" id="image-container">
    {% if comic.image_url %}
    <img class="image image-dither" src="{{ comic.image_url }}" id="comic"/>
    {% else %}
    <p class="text--black">Error Loading Twonks...</p>
    {% endif %}
  </div>
  <div class="title_bar" id="info">
    <span class="text-stroke" id="name">{{ channel_title }}</span>
    <span class="instance text-stroke" id="lego-meta">{{ comic.title }}</span>
  </div>
</div>
